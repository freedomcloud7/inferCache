FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[test]"

# Copy source
COPY services/ services/
COPY tests/ tests/

# Environment
ENV PYTHONPATH=/app
ENV GATEWAY_PORT=8080
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["sh", "-c", "uvicorn services.gateway.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
